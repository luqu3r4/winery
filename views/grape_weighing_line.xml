<odoo>
    <data>
        <record id="winery_grape_weighing_line_form" model="ir.ui.view">
            <field name="name">winery.grape.weighing.line.form</field>
            <field name="model">winery.grape.weighing.line</field>
            <field name="arch" type="xml">
                <form>
                    <sheet>
                        <!-- Referencia, fecha y viticultor -->
                        <group>
                            <field name="name"/>
                            <field name="datetime"/>
                            <field name="winegrower_id"/>
                            <field name="winegrower_code" readonly="1"/>
                        </group>

                        <!-- Parcela filtrada según viticultor -->
                        <group>
                            <field name="plot_id"/>
                        </group>

                        <!-- Opciones de vino -->
                        <group>
                            <field name="table_wine"/>
                            <field name="grape_variety_id"/>
                            <field name="alcohol_degree"/>
                        </group>

                        <!-- Pesos -->
                        <group>
                            <field name="gross_weight"/>
                            <field name="tare_weight"/>
                            <field name="net_weight" readonly="1"/>
                        </group>

                        <!-- Descripción -->
                        <group>
                            <field name="notes"/>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>
    </data>
</odoo>
