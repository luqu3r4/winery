<odoo>
  <data>
    <record id="winery_grape_weighing_form" model="ir.ui.view">
      <field name="name">winery.grape_weighing.form</field>
      <field name="model">winery.grape_weighing</field>
      <field name="arch" type="xml">
        <form>
          <sheet>
            <!-- Campos principales -->
            <group>
              <field name="name"/>
              <field name="datetime"/>
              <field name="alcohol_degree"/>
              <field name="gross_weight"/>
              <field name="tare_weight"/>
              <field name="net_weight" readonly="1"/>
            </group>

            <!-- Título de sección -->
            <div class="o_form_label" style="margin-top:10px; font-weight:bold; font-size:14px;">
              Pesadas por Parcela
            </div>

            <!-- Líneas de pesada -->
            <field name="line_ids"
                   context="{}"
                   mode="tree,form"
                   views="[(ref('winery_grape_weighing_line_form'), 'form'), (False, 'tree')]"/>
          </sheet>
        </form>
      </field>
    </record>

    <!-- Vista Tree -->
    <record id="winery_grape_weighing_tree" model="ir.ui.view">
      <field name="name">winery.grape_weighing.tree</field>
      <field name="model">winery.grape_weighing</field>
      <field name="arch" type="xml">
        <tree>
          <field name="name"/>
          <field name="datetime"/>
          <field name="alcohol_degree"/>
          <field name="gross_weight"/>
          <field name="tare_weight"/>
          <field name="net_weight"/>
        </tree>
      </field>
    </record>

    <!-- Acción -->
    <record id="winery_grape_weighing_action" model="ir.actions.act_window">
      <field name="name">Pesadas de Uva</field>
      <field name="res_model">winery.grape_weighing</field>
      <field name="view_mode">tree,form</field>
    </record>
  </data>
</odoo>
