<odoo>
  <data>
      <record id="winery_plot_tree" model="ir.ui.view">
          <field name="name">winery.plot.tree</field>
          <field name="model">winery.plot</field>
          <field name="arch" type="xml">
              <tree>
                  <field name="name"/>
                  <field name="plot_number"/>
                  <field name="cadastral_ref"/>
                  <field name="city"/>
                  <field name="gps_coords"/>
                  <field name="country_id"/>
                  <field name="state_id"/>
                  <field name="area_ha"/>
                  <field name="grape_variety_id"/>
                  <field name="winegrower_id"/>
                  <field name="aggregation"/>
                  <field name="zone"/>
                  <field name="sigpac_info"/>
              </tree>
          </field>
      </record>
      <record id="winery_plot_form" model="ir.ui.view">
          <field name="name">winery.plot.form</field>
          <field name="model">winery.plot</field>
          <field name="arch" type="xml">
              <form>
                  <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Nombre de la parcela"/>
                        </h1>
                    </div>
                      <group>
                          <group string="Datos Generales">
                              <field name="plot_number"/>
                              <field name="winegrower_id"/>
                              <field name="cadastral_ref"/>
                              <field name="area_ha"/>
                        </group>
                        <group>
                            <group string="Detalles de Cultivo">
                              <field name="grape_variety_id"/>
                              <field name="aggregation"/>
                            </group>
                        </group>
                        <group>
                            <group string="Información de Ubicación">
                                <field name="city"/>
                                <field name="country_id"/>
                                <field name="state_id"/>
                            </group>
                        </group>
                        <group>
                            <group string="Datos Avanzados">
                                <field name="zone"/>
                                <field name="gps_coords"/>
                                <field name="sigpac_info"/>
                            </group>
                          </group>
                      </group>
                  </sheet>
              </form>
          </field>
      </record>


      <record model="ir.actions.act_window" id="plot_action_window">
          <field name="name">Creacion de Parcelas</field>
          <field name="res_model">winery.plot</field>
          <field name="view_mode">tree,form</field>
          <field name="help" type="html">
              <p class="o_view_nocontent_smiling_face">
                  Gestión de las parcelas de la bodega
              </p>
              <p>
                  Aquí podrás gestionar todas las parcelas de la bodega
              </p>
          </field>
      </record>
  </data>
</odoo>