<odoo>
  <data>
      <record id="winery_plot_tree" model="ir.ui.view">
          <field name="name">winery.plot.tree</field>
          <field name="model">winery.plot</field>
          <field name="arch" type="xml">
              <tree>
                  <field name="name"/>
                  <field name="description"/>
                  <field name = "plot_number"/>
                  <field name = "cadastral_ref"/>
                  <field name = "city"/>
                  <field name = "gps_coords"/>
                  <field name="country_id"/>
                  <field name="state_id"/>
                  <field name="area_ha"/>
                  <field name="grape_variety_id"/>
                  <field name="winegrower_id"/>
                  <field name="aggregation"/>
                  <field name="zone"/>
                  <field name="sigpac_info"/>
                  <field name="state"/> 
              </tree>
          </field>
      </record>
      <record id="winery_plot_form" model="ir.ui.view">
          <field name="name">winery.plot.form</field>
          <field name="model">winery.plot</field>
          <field name="arch" type="xml">
              <form>
                  <sheet>
                      <group name="group_top">
                          <group name="group_left" string="Grupo Izquierda">
                              <field name="name"/>
                              <field name="plot_number"/>
                              <field name="cadastral_ref"/>
                              <field name = "area_ha"/>
                              <field name="grape_variety_id"/>
                              <field name="winegrower_id"/>
                              <field name="sigpac_info"/>
                              <field name="description"/>
                              <field name="state"/>
                          </group>
                          <group name="group_right">
                              <field name="country_id"/>
                              <field name="state_id"/>
                              <field name="city"/>
                              <field name="gps_coords"/>
                              <field name="aggregation"/>
                              <field name="zone"/>
                              
                          </group>
                      </group>
                  </sheet>
              </form>
          </field>
      </record>
      <record model="ir.actions.act_window" id="plot_action_window">
          <field name="name">Creacion de Parcelas</field>
          <field name="res_model">winery.plot</field>
          <field name="view_mode">tree,form</field>
          <field name="help" type="html">
              <p class="oe_view_nocontent_create">
                  Gestion de las parcelas de una bodega.
              </p>
              <p>
                  Haz clic en 'Crear' para añadir nuevas parcelas.
              </p>
          </field>
      </record>
  </data>
</odoo>