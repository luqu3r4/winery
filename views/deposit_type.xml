<odoo>
  <data>
      <record id="winery_deposit_type_tree" model="ir.ui.view">
          <field name="name">winery.deposit_type.tree</field>
          <field name="model">winery.deposit_type</field>
          <field name="arch" type="xml">
              <tree>
                  <field name="name"/>
                  <field name="code"/>
                  <field name="material"/>
                  <field name="default_capacity"/>
                  <field name="default_tolerance"/>
                  <field name="active"/>
                  <field name="description"/>
                  <field name="deposit_ids"/>
              </tree>
          </field>
      </record>
        <record id="winery_deposit_type_form" model="ir.ui.view">
          <field name="name">winery.deposit_type.form</field>
          <field name="model">winery.deposit_type</field>
          <field name="arch" type="xml">
              <form>
                  <sheet>
                      <group name="group_top">
                          <group name="group_left" string="Grupo Izquierda">
                              <field name="name"/>
                              <field name="code"/>
                              <field name="material"/>
                              <field name="default_capacity"/>
                              <field name="default_tolerance"/>
                              <field name="active"/>
                              <field name="description"/>
                              <field name="deposit_ids"/>
                          </group>
                          <group name="group_right">
                          </group>
                      </group>
                  </sheet>
              </form>
          </field>
      </record>
      <record model="ir.actions.act_window" id="deposit_type_action_window">
        <field name="name">deposit_type</field>
        <field name="res_model">winery.deposit_type</field>
        <field name="view_mode">tree,form</field>
        <field name="help" type="html">
            <p class="oe_view_nocontent_create">
                Mi modelo
            </p>
            <p>
                Click 'Crear' para añadir nuevos elementos.
            </p>
        </field>
    </record>
  </data>
</odoo>